#!/bin/bash
#SBATCH --job-name=PINNo_slow_prob
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=4:00:00
#SBATCH --output=/share_zeta/Proxy-Sim/guillermo.carrillo/PINNo_slow_%j.log

. /share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiffPhys/bash_routines/set_env.sh ICA

GRID_N=${1:-11}
EPOCHS=${2:-3}

echo "=== PINNoDiffPhys slowdown probe ===  grid=$GRID_N  epochs=$EPOCHS  START=$(date)"
cd "$PATH_CODE"

CONTAINER="$PATH_ENV/fem_pytorch/envs/firedrake.sif"
echo "Using container: $CONTAINER"

export SINGULARITY_BIND="$PATH_CODE:/code,$(pwd):/workspace"
singularity exec "$CONTAINER" python3 /code/diag_slowdown.py --grid_n "$GRID_N" --epochs "$EPOCHS"

RC=$?
echo "=== ICA exit code: $RC ==="
exit $RC