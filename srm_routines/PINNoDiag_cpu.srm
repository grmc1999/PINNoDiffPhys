#!/bin/bash
#SBATCH --job-name=PINNoDiag
#SBATCH --partition=cpu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:20:00
#SBATCH --output=/share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiag_%j.log

# Debug harness to inspect the firedrake-adjoint tape inside the runtime container.
. /share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiffPhys/bash_routines/set_env.sh ICA

cd "$PATH_CODE"
export SINGULARITY_BIND="$PATH_CODE:/code,$(pwd):/workspace"
export PYTHONUNBUFFERED=1

CONTAINER="$PATH_ENV/fem_pytorch/envs/firedrake.sif"
echo "=== diag start $(date) container=$CONTAINER ==="
singularity exec "$CONTAINER" python3 /code/diag_poisson.py
echo "=== diag exit code: $? $(date) ==="