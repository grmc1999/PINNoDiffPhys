#!/bin/bash
#SBATCH --job-name=PINNo_diag0
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --output=/share_zeta/Proxy-Sim/guillermo.carrillo/PINNo_diag0_%j.log

# Probe 1c: zeroed-CNN bisect (plumbing vs learned-weights transpose).
. /share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiffPhys/bash_routines/set_env.sh ICA
cd "$PATH_CODE"

export SINGULARITY_BIND="$PATH_CODE:/code,$(pwd):/workspace"
CONTAINER="$PATH_ENV/fem_pytorch/envs/firedrake.sif"
DIAG_DIR="$PATH_CODE/diag"
mkdir -p "$DIAG_DIR"
LOG="$DIAG_DIR/$SLURM_JOB_ID.log"

exec > >(tee -a "$LOG") 2>&1
echo "=== DIAG ZERO START $(date) ==="
echo "SLURM_JOB_ID=$SLURM_JOB_ID"

export EXP_DIR=/code/EXPS/advection_grid16_seed0
export N_STEPS=10
singularity exec "$CONTAINER" python3 /code/diag_zero.py

echo "=== DIAG ZERO COMPLETE $(date) ==="
echo "Log saved to $LOG"