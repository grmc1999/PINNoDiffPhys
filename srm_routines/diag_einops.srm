#!/bin/bash
#SBATCH --job-name=PINNo_diagE
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --output=/share_zeta/Proxy-Sim/guillermo.carrillo/PINNo_diagE_%j.log

# Probe 1e: einops flatten vs data_ro reshape isolation.
. /share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiffPhys/bash_routines/set_env.sh ICA
cd "$PATH_CODE"

export SINGULARITY_BIND="$PATH_CODE:/code,$(pwd):/workspace"
CONTAINER="$PATH_ENV/fem_pytorch/envs/firedrake.sif"
DIAG_DIR="$PATH_CODE/diag"
mkdir -p "$DIAG_DIR"
LOG="$DIAG_DIR/$SLURM_JOB_ID.log"

exec > >(tee -a "$LOG") 2>&1
echo "=== DIAG EINOPS START $(date) ==="
echo "SLURM_JOB_ID=$SLURM_JOB_ID"
singularity exec "$CONTAINER" python3 /code/diag_einops.py
echo "=== DIAG EINOPS COMPLETE $(date) ==="
echo "Log saved to $LOG"