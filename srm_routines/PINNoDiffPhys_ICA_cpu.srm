#!/bin/bash
#SBATCH --job-name=PINNo_ICA
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=48:00:00
#SBATCH --output=/share_zeta/Proxy-Sim/guillermo.carrillo/PINNo_ICA_%j.log

# PINNoDiffPhys wave-1 single-config job (ICA cpu).
# slurm copies this SRM to the spool dir, so locate the repo via the
# hardcoded PATH_CODE from set_env.sh.
. /share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiffPhys/bash_routines/set_env.sh ICA

EXP_DIR=${1:-"EXPS/diffusion_grid11_seed0"}

echo "=== PINNoDiffPhys ICA ==="
echo "EXP_DIR=$EXP_DIR  CLUSTER=$CLUSTER_ID  START=$(date)"

CONTAINER="$PATH_ENV/fem_pytorch/envs/firedrake.sif"
echo "Using container: $CONTAINER"

CONFIG="$EXP_DIR/config.json"
cd "$PATH_CODE"

echo "--- clearing stale artifacts from prior runs (keeping config.json) ---"
rm -rf "$EXP_DIR/plots"
rm -f "$EXP_DIR/summary.json" "$EXP_DIR/trained_model.pt" "$EXP_DIR/checkpoint.pt" \
      "$EXP_DIR/train_errors.json" "$EXP_DIR/train_errors.npy" "$EXP_DIR/train_losses.npy"

PDE=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('pde','diffusion'))")
SEED=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('seed',0))")
GRID=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('train_grid_n',11))")
EPOCHS=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('n_epochs',50))")
BATCH=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('batch_size',8))")
ROLLOUT=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('num_rollout',5))")
M_ITERS=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('m_iters',5))")
SAVE_EVERY=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('save_every',10))")
SKIP_POSTERIOR=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('skip_posterior',0))")

if [ "$SKIP_POSTERIOR" = "1" ]; then
    export PINNO_SKIP_POSTERIOR=1
fi

SCRIPT="Train_test_${PDE}.py"
ARGS="--seed $SEED --train_grid_n $GRID --n_epochs $EPOCHS --batch_size $BATCH --num_rollout $ROLLOUT --save_every $SAVE_EVERY --exp_name $(basename $EXP_DIR) --base_output_dir /code/EXPS"

if [ "$PDE" = "diffusion" ]; then
    DT=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('dt',0.1))")
    ARGS="$ARGS --dt $DT"
elif [ "$PDE" = "advection" ]; then
    DT=$(python3 -c "import json; c=json.load(open('$CONFIG')); print(c.get('dt',0.01))")
    ARGS="$ARGS --dt $DT"
elif [ "$PDE" = "poisson" ]; then
    ARGS="$ARGS --m_iters $M_ITERS"
fi

echo "Running: python /code/$SCRIPT $ARGS"
export SINGULARITY_BIND="$PATH_CODE:/code,$(pwd):/workspace"
singularity exec "$CONTAINER" python3 "/code/$SCRIPT" $ARGS

RC=$?
echo "=== ICA exit code: $RC ==="
echo "--- artifacts check ---"
ls -la "$EXP_DIR/plots" 2>&1 | head -20
test -s "$EXP_DIR/summary.json" && echo "ARTIFACTS_OK: summary.json present" || echo "WARN: summary.json missing (output writes lost?)"
echo "--- end artifacts check ---"
exit $RC
