#!/bin/bash
#SBATCH --job-name=smoke_PINNoDiff
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --nodelist=cpunode-2-1
#SBATCH --output=/share_zeta/Proxy-Sim/guillermo.carrillo/smoke_PINNoDiff_%j.log

# PINNoDiffPhys smoke test (ICA cpu). Validates the diffusion_loss fix
# plus all steppers (poisson, diffusion, advection).
. /share_zeta/Proxy-Sim/guillermo.carrillo/PINNoDiffPhys/bash_routines/set_env.sh ICA

echo "=== PINNoDiffPhys smoke test ==="
echo "CLUSTER=$CLUSTER_ID  START=$(date)"

CONTAINER="$PATH_ENV/fem_pytorch/envs/firedrake.sif"
echo "Using container: $CONTAINER"

export SINGULARITY_BIND="$PATH_CODE:/code"
cd "$PATH_CODE"
singularity exec "$CONTAINER" python3 /code/smoke/smoke_test.py

RC=$?
echo "=== smoke test exit code: $RC ==="
exit $RC
