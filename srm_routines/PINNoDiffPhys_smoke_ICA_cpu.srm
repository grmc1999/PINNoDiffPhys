#!/bin/bash
#SBATCH --job-name=smoke_PINNoDiff
#SBATCH --partition=normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:15:00
#SBATCH --output=%x_%j.log

# --- arguments ---
EXP_DIR=${1:-"EXPS/smoke"}
CLUSTER=${2:-"ICA"}

echo "=== PINNoDiffPhys smoke test ==="
echo "EXP_DIR=$EXP_DIR  CLUSTER=$CLUSTER  START=$(date)"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# --- container (ICA) ---
CONTAINER="$PATH_ENV/envs/ICA_v4.sif"

if [ -f "$CONTAINER" ]; then
    echo "Using container: $CONTAINER"
    export SINGULARITY_BIND="$SCRIPT_DIR:/code,$(pwd):/workspace"
    singularity exec "$CONTAINER" python /code/smoke/smoke_test.py
else
    echo "No container found at $CONTAINER — running with system python"
    cd "$SCRIPT_DIR"
    python smoke/smoke_test.py
fi

RC=$?
echo "=== smoke test exit code: $RC ==="
exit $RC
